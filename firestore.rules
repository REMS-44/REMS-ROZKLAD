rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function enabled() { return profileExists() && profile().enabled != false; }
    function roleIs(r) { return enabled() && profile().role == r; }
    function admin() { return roleIs('admin'); }
    function dispatcher() { return roleIs('dispatcher'); }
    function teacher() { return roleIs('teacher'); }
    function fullReader() {
      return enabled() && (profile().role == 'admin' || profile().role == 'dispatcher' || profile().role == 'viewer');
    }
    function ownTeacherRecord() {
      return teacher()
        && profile().teacherId != null
        && resource.data.teacherId == profile().teacherId;
    }

    match /system/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/system/bootstrap)
                    && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if signedIn() && (
        (
          !exists(/databases/$(database)/documents/system/bootstrap)
          && request.auth.uid == uid
          && request.resource.data.role == 'admin'
        )
        || admin()
      );
      allow update, delete: if admin();
    }

    // Teachers need only the common academic period / bell schedule.
    match /workspaces/{workspaceId}/settings/{docId} {
      allow read: if enabled();
      allow write: if admin();
    }

    // A teacher can read only schedule documents assigned to their linked teacherId.
    // The client query must include where("teacherId", "==", profile.teacherId).
    match /workspaces/{workspaceId}/schedule/{lessonId} {
      allow read: if fullReader() || ownTeacherRecord();
      allow write: if admin() || dispatcher();
    }

    match /workspaces/{workspaceId}/roomBookings/{bookingId} {
      allow read: if fullReader() || ownTeacherRecord();
      allow write: if admin() || dispatcher();
    }

    match /workspaces/{workspaceId}/locks/{lockId} {
      allow read: if fullReader();
      allow write: if admin() || dispatcher();
    }

    // Other departmental collections are not readable by the teacher role.
    match /workspaces/{workspaceId}/{collectionName}/{docId} {
      allow read: if fullReader();
      allow write: if admin();
    }
  }
}
