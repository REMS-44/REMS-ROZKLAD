rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function enabled() { return profileExists() && profile().enabled != false; }
    function roleIs(r) { return enabled() && profile().role == r; }
    function admin() { return roleIs('admin'); }
    function dispatcher() { return roleIs('dispatcher'); }

    match /system/bootstrap {
      // Needed only so the very first authenticated account can bootstrap the system.
      allow read: if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/system/bootstrap)
                    && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /users/{uid} {
      // A user can read their own access profile; admins can manage the directory.
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();

      // After bootstrap, only an existing admin can provision another user's profile.
      // Creating an Authentication account alone therefore does NOT grant database access.
      allow create: if signedIn() && (
        (
          !exists(/databases/$(database)/documents/system/bootstrap)
          && request.auth.uid == uid
          && request.resource.data.role == 'admin'
        )
        || admin()
      );

      allow update, delete: if admin();
    }

    // All enabled provisioned users can read the common workspace.
    match /workspaces/{workspaceId}/{document=**} {
      allow read: if enabled();
      allow write: if admin();
    }

    // Dispatcher can change timetable records and conflict locks, but not curricula/workload.
    match /workspaces/{workspaceId}/schedule/{lessonId} {
      allow write: if admin() || dispatcher();
    }
    match /workspaces/{workspaceId}/locks/{lockId} {
      allow write: if admin() || dispatcher();
    }
  }
}
